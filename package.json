{
  "name": "gatehouse",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "seed": "tsx scripts/seed.ts",
    "trace": "tsx packages/runner/src/cli.ts",
    "stack": "tsx scripts/stack.ts",
    "approve": "tsx packages/gateway/src/cli.ts approve",
    "reject": "tsx packages/gateway/src/cli.ts reject",
    "measure": "tsx scripts/measure.ts",
    "dev": "pnpm --filter web dev",
    "record": "pnpm --filter web build && tsx scripts/record-gif.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@faker-js/faker": "10.6.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "js-tiktoken": "1.0.21",
    "pg": "8.23.1",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
